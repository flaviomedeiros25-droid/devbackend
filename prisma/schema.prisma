generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Profile {
  id          String    @id @default(uuid())
  name        String
  email       String    @unique
  bio         String
  githubUrl   String
  linkedinUrl String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relacionamento Profile 1 : N Project
  projects    Project[]

  @@map("profiles")
}

model Technology {
  id        String    @id @default(uuid())
  name      String    @unique
  category  String?
  createdAt DateTime  @default(now())

  // Relacionamento Project N : N Technology (Implicit join table)
  projects  Project[]

  @@map("technologies")
}

model Project {
  id            String       @id @default(uuid())
  title         String
  description   String
  repositoryUrl String
  deployUrl     String?
  profileId     String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  // Relacionamento Profile 1 : N Project
  profile       Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)

  // Relacionamento Project N : N Technology
  technologies  Technology[]

  // Relacionamento Project 1 : N Feedback
  feedbacks     Feedback[]

  @@map("projects")
}

model Feedback {
  id        String   @id @default(uuid())
  author    String
  comment   String
  rating    Int?
  projectId String
  createdAt DateTime @default(now())

  // Relacionamento Project 1 : N Feedback
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("feedbacks")
}
